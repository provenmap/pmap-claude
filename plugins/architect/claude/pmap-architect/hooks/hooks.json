{
  "description": "ProvenMap Architect hooks: session-start pointer at /start, display guard + turn marker, next-steps gate (no .provenmap scaffold)",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"ProvenMap Architect loaded — run /start to see where you are and what to run next.\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/pmap-display-guard.js",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/pmap-next-steps-gate.js",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
